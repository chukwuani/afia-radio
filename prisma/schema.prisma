generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model Show {
    id          String     @id @default(auto()) @map("_id") @db.ObjectId
    title       String
    host        String
    description String
    coverArt    String
    duration    Int
    category    String
    tags        String[]
    schedule    Schedule[]
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt
}

model Schedule {
    id        String @id @default(auto()) @map("_id") @db.ObjectId
    day       Day
    startTime String // Format: "HH:MM"
    endTime   String // Format: "HH:MM"
    show      Show   @relation(fields: [showId], references: [id])
    showId    String @db.ObjectId
}

model Podcast {
    id          String           @id @default(auto()) @map("_id") @db.ObjectId
    title       String
    host        String
    description String
    coverArt    String
    category    String
    tags        String[]
    episodes    PodcastEpisode[]
    createdAt   DateTime         @default(now())
    updatedAt   DateTime         @updatedAt
}

model PodcastEpisode {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    title       String
    description String
    duration    Int // in minutes
    audioUrl    String
    releaseDate DateTime
    podcast     Podcast  @relation(fields: [podcastId], references: [id])
    podcastId   String   @db.ObjectId
}

model MusicPlaylist {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    name        String
    description String
    coverArt    String
    curator     String
    songs       Song[]   @relation(fields: [songIds], references: [id])
    songIds     String[] @db.ObjectId
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model Song {
    id          String          @id @default(auto()) @map("_id") @db.ObjectId
    title       String
    artist      String
    coverArt    String
    album       String?
    duration    Int // in seconds
    audioUrl    String
    playlists   MusicPlaylist[] @relation(fields: [playlistIds], references: [id])
    playlistIds String[]        @db.ObjectId
}

enum Day {
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY
    SATURDAY
    SUNDAY
}
